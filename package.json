{
  "name": "pratsia-recovered",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/migrate-local.mjs && next build --webpack",
    "start": "node scripts/migrate-local.mjs && next start",
    "db:migrate": "node scripts/migrate-local.mjs",
    "db:backup": "node scripts/backup-local.mjs",
    "moderator": "node scripts/moderator.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/test-http.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.3.3",
    "next": "16.3.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.6.7",
    "vite": "7.3.8"
  }
}
