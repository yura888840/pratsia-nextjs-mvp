PRATSIA_DATA_DIR=./data
# Set to the exact origin used in your browser (scheme + hostname + port).
PRATSIA_ORIGIN=http://localhost:3000
# Local default: do not send recovery emails.
PRATSIA_MAIL_DISABLED=1
PRATSIA_MAIL_FROM=no-reply@pratsia.com.ua
PRATSIA_SENDMAIL_PATH=/usr/sbin/sendmail
# PRATSIA_BACKUP_DIR=./backups

# Google OAuth Web application credentials (server-only).
# Authorized redirect URI: <PRATSIA_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
